[Unit]
Description=glovebox dashcam drive service
# Start as early as possible: until glovebox presents the drive, the car can't
# record. It needs local filesystems, not the network; archiving waits for
# the NAS by itself. A plain /backingfiles is mounted from fstab first
# (backingfiles.mount); an encrypted one only exists once glovebox has
# opened it, so glovebox mounts that itself and doesn't require the mount.
DefaultDependencies=no
After=local-fs.target systemd-udevd.service backingfiles.mount
Wants=local-fs.target
Before=multi-user.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=simple
# Runs as root: it manages the USB gadget, loop devices and mounts.
ExecStart=/usr/local/bin/glovebox -config /etc/glovebox/glovebox.toml
Restart=on-failure
# /run/glovebox: mount points (snapshots, NFS) and sockets; kept when the
# service stops, so systemd never tries to delete a mounted snapshot
RuntimeDirectory=glovebox
RuntimeDirectoryPreserve=yes
RestartSec=5

[Install]
WantedBy=multi-user.target
